{
    "name": "@endosome/gmail-js",
    "version": "1.1.16",
    "description": "JavaScript API for Gmail (useful for chrome extensions)",
    "main": "src/gmail.js",
    "types": "src/gmail.d.ts",
    "files": [
        "src/gmail.js",
        "src/gmail.d.ts",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/endosome/gmail.js.git"
    },
    "scripts": {
        "lint": "eslint src/*.js",
        "typecheck": "tsc --ignoreConfig --types jquery src/*.ts",
        "test": "jest --watchAll=false --reporters=default --reporters=jest-junit",
        "ci": "npm run typecheck && npm run test && npm run lint"
    },
    "keywords": [
        "gmail",
        "gmail api",
        "gmail.js",
        "gmail extension",
        "gmail chrome extension",
        "gmail firefox extension"
    ],
    "devDependencies": {
        "@types/jquery": "^4.0.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-junit": "^17.0.0",
        "jquery": "^4.0.0",
        "jsdom": "^30.1.3",
        "typescript": "^7.0.2"
    },
    "author": "Kartik Talwar",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/endosome/gmail.js/issues"
    },
    "homepage": "https://github.com/endosome/gmail.js",
    "publishConfig": {
        "access": "public"
    }
}
